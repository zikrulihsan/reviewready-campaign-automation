{
  "name": "Supabase Submission to Review Packet and Demo Email",
  "nodes": [
    {
      "id": "webhook",
      "name": "Campaign Submitted Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        280
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "campaign-submitted",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "campaign-submitted-p0-p1",
      "notes": "Assign a Webhook Header Auth credential before publishing."
    },
    {
      "id": "validate",
      "name": "Validate Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        280
      ],
      "parameters": {
        "jsCode": "const envelope = $input.first().json.body ?? $input.first().json;\nconst record = envelope.record && typeof envelope.record === 'object' ? envelope.record : envelope;\nconst source = record.payload && typeof record.payload === 'object' ? record.payload : record;\nconst eventId = source.event_id;\nconst campaignId = source.campaign_id;\nconst version = source.campaign_version;\nconst valid = (source.type === 'CAMPAIGN_SUBMITTED' || envelope.type === 'INSERT')\n  && typeof eventId === 'string' && /^[A-Za-z0-9_-]{1,128}$/.test(eventId)\n  && typeof campaignId === 'string' && /^[A-Za-z0-9_-]{1,128}$/.test(campaignId)\n  && Number.isSafeInteger(version) && version > 0;\nreturn [{ json: {\n  valid,\n  error: valid ? null : 'Expected a Supabase insert containing a CAMPAIGN_SUBMITTED payload',\n  event_id: valid ? eventId : null,\n  campaign_id: valid ? campaignId : null,\n  campaign_version: valid ? version : null,\n  api_base_url: 'https://REPLACE_WITH_NETLIFY_SITE.netlify.app',\n  app_base_url: 'https://REPLACE_WITH_NETLIFY_SITE.netlify.app'\n}}];"
      },
      "notes": "Set api_base_url and app_base_url to the deployed Netlify site URL."
    },
    {
      "id": "if-valid",
      "name": "Valid Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        280
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-valid-condition",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "bad-request",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        440
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ accepted: false, error: $json.error }) }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "accepted",
      "name": "Respond 202",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ accepted: true, event_id: $json.event_id }) }}",
        "options": {
          "responseCode": 202
        }
      },
      "notes": "Acknowledges a valid event before the longer processing starts."
    },
    {
      "id": "claim",
      "name": "Load Campaign and Claim Processing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Validate Event').first().json.api_base_url + '/internal/campaigns/' + $('Validate Event').first().json.campaign_id + '/claim-processing' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_id: $('Validate Event').first().json.event_id, campaign_version: $('Validate Event').first().json.campaign_version }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Assign the Netlify internal Header Auth credential after import."
    },
    {
      "id": "if-process",
      "name": "Process This Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-process-condition",
              "leftValue": "={{ $json.should_process === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "if-docs",
      "name": "Document Analysis Needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-docs-condition",
              "leftValue": "={{ $json.needs_document_analysis === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "docs",
      "name": "Analyze Pending Documents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        20
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Validate Event').first().json.api_base_url + '/internal/campaigns/' + $('Validate Event').first().json.campaign_id + '/analyze-documents' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_id: $('Validate Event').first().json.event_id, campaign_version: $('Validate Event').first().json.campaign_version }) }}"
      },
