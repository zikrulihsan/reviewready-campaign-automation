      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        140
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Validate Event').first().json.api_base_url + '/internal/campaigns/' + $('Validate Event').first().json.campaign_id + '/build-review-packet' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_id: $('Validate Event').first().json.event_id, campaign_version: $('Validate Event').first().json.campaign_version }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Assign the Netlify internal Header Auth credential after import."
    },
    {
      "id": "mock-email-notification",
      "name": "Compose Demo Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        140
      ],
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst event = $('Validate Event').first().json;\nconst needsCreatorUpdate = result.awaiting_creator === true;\nconst campaignUrl = needsCreatorUpdate\n  ? `${event.app_base_url}/creator/campaign/${event.campaign_id}`\n  : `${event.app_base_url}/reviewer/campaign/${event.campaign_id}`;\nconst notificationKind = needsCreatorUpdate ? 'needs_clarification' : 'ready_for_review';\nconst subject = needsCreatorUpdate\n  ? 'A few campaign details need your attention'\n  : 'Campaign ready for review';\nconst body = needsCreatorUpdate\n  ? `Your campaign needs a little more information before it enters the review queue. Open it here: ${campaignUrl}`\n  : `Campaign ${event.campaign_id} is ready in the reviewer queue. Open it here: ${campaignUrl}`;\nreturn [{ json: {\n  packet_result: result,\n  notification_kind: notificationKind,\n  email_notification: {\n    mode: 'mock', delivery_status: 'mock_sent', to: 'zikrulihsanmd@gmail.com',\n    subject, body, campaign_id: event.campaign_id, event_id: event.event_id,\n    campaign_version: event.campaign_version\n  }\n}}];"
      },
      "notes": "Creates the demo email payload. The next node persists it to Supabase through the internal API; no email provider is contacted."
    },
    {
      "id": "if-detailed",
      "name": "Continue to Reviewer Analysis?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1980,
        140
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "continue-review-condition",
              "leftValue": "={{ $json.continue_to_packet === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "reviewer-analysis",
      "name": "Prepare Detailed Reviewer Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        20
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Validate Event').first().json.api_base_url + '/internal/campaigns/' + $('Validate Event').first().json.campaign_id + '/reviewer-analysis' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 35000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_id: $('Validate Event').first().json.event_id, campaign_version: $('Validate Event').first().json.campaign_version }) }}"
      },
      "retryOnFail": false,
      "notes": "Assign the Netlify internal Header Auth credential after import. Runs separately from readiness so each function stays within the 60-second limit."
    },
    {
      "id": "persist-mock-email",
      "name": "Save Demo Email to Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2860,
        140
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Validate Event').first().json.api_base_url + '/internal/campaigns/' + $('Validate Event').first().json.campaign_id + '/mock-email' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 35000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_id: $('Validate Event').first().json.event_id, campaign_version: $('Validate Event').first().json.campaign_version, notification_kind: $json.notification_kind, recipient: $json.email_notification.to, subject: $json.email_notification.subject, body: $json.email_notification.body }) }}"
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "notes": "Assign the Netlify internal Header Auth credential after import."
    }
  ],
