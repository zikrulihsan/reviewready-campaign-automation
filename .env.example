# Supabase > Connect > Transaction pooler (server-side only)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres
DATABASE_SSL=require

# Generate a long random value; configure the same value as n8n HTTP Header Auth.
INTERNAL_TOKEN=replace-with-a-long-random-token

# Optional: leave empty to keep AI findings marked unavailable while deterministic checks continue.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public site origin used in notification links (for example https://your-site.netlify.app).
PUBLIC_APP_URL=

# Reviewer channel incoming webhook. Keep this server-side.
SLACK_REVIEWER_WEBHOOK_URL=

# Creator email delivery through the existing SMTP provider.
SMTP_HOST=smtp.sumopod.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sumopod documents port 465 with SSL enabled.
SMTP_SECURE=true
NOTIFICATION_FROM_EMAIL="ReviewReady <sender@example.com>"
