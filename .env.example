# Supabase > Connect > Transaction pooler (server-side only)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres
DATABASE_SSL=require

# Generate a long random value; configure the same value as n8n HTTP Header Auth.
INTERNAL_TOKEN=replace-with-a-long-random-token

# Optional: leave empty to keep AI findings marked unavailable while deterministic checks continue.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
